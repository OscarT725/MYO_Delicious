<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/azul_claro"
    tools:context=".ui.inicio.SlideSecundarioActivity">


    <ImageView
        android:layout_width="match_parent"
        android:layout_height="410dp"
        android:layout_marginTop="-85sp"
        android:src="@drawable/slide_secundario" />

    <TextView
        android:layout_width="349dp"
        android:layout_height="wrap_content"
        android:layout_margin="25dp"
        android:src="@android:drawable/dialog_holo_dark_frame"
        android:text="@string/tex_slide2"
        android:textColor="@color/blue"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tex_slide_secundario"
        android:textSize="28sp"
        android:layout_marginStart="35sp"
        android:layout_marginEnd="25sp"
        android:textColor="@color/black"
        android:layout_marginTop="3sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/text_slide_secundario2"
        android:layout_marginStart="38sp"
        android:layout_marginEnd="30sp"
        android:layout_marginTop="15sp"
        android:textSize="18sp"
        android:textColor="@color/black" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="60sp"
        android:layout_marginStart="10sp"
        android:layout_marginEnd="10sp">

        <Button
            android:id="@+id/btn_omitir1"
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="15sp"
            android:layout_marginEnd="15sp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:text="@string/button_omitir"
            android:textColor="@color/black"
            android:backgroundTint="@color/white"
            app:strokeWidth = "2dp"
            app:strokeColor = "@color/black"/>


        <Button
            android:id="@+id/btn_siguiente2"
            android:layout_width="140sp"
            android:layout_height="wrap_content"
            android:layout_marginStart="15sp"
            android:layout_marginEnd="15sp"
            android:backgroundTint="@color/blue"
            android:text="@string/button_siguiente"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:strokeColor="@color/black"
            app:strokeWidth="2dp" />

    </LinearLayout>


</LinearLayout>